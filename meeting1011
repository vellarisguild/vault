            <h2 class="text-2xl font-semibold text-white border-b-2 border-violet-500 pb-2 mb-4" data-th="ประเด็นที่ยังไม่ได้รับการแก้ไข" data-en="Unresolved Issues & Parking Lot">Unresolved Issues & Parking Lot</h2>
            <div class="bg-slate-800 p-4 rounded-lg shadow-md">
                 <p data-th="ทุกคำถามได้รับการแก้ไขและทุกหัวข้อได้ข้อสรุปในการประชุมครั้งนี้" data-en="All questions were resolved and all topics were concluded in this meeting.">All questions were resolved and all topics were concluded in this meeting.</p>
            </div>
        </section>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Language Toggle
            const langToggle = document.getElementById('lang-toggle');
            let currentLang = 'en';

            langToggle.addEventListener('click', () => {
                currentLang = currentLang === 'en' ? 'th' : 'en';
                langToggle.textContent = currentLang.toUpperCase();
                updateTextContent(currentLang);
            });

            function updateTextContent(lang) {
                document.querySelectorAll('[data-en]').forEach(el => {
                    el.innerHTML = el.dataset[lang];
                });
            }
            
            updateTextContent('th'); // Default to Thai
            langToggle.textContent = 'TH';


            // Tabs
            const tabs = document.querySelectorAll('.tab-link');
            const tabContents = document.querySelectorAll('.tab-content');

            tabs.forEach(tab => {
                tab.addEventListener('click', (e) => {
                    e.preventDefault();
                    
                    tabs.forEach(item => {
                        item.classList.remove('border-cyan-400', 'text-cyan-400');
                        item.classList.add('border-transparent');
                    });
                    
                    tab.classList.add('border-cyan-400', 'text-cyan-400');
                    tab.classList.remove('border-transparent');
                    
                    const tabId = tab.dataset.tab;
                    tabContents.forEach(content => {
                        content.classList.remove('active');
                        // *** BUG FIX: Correctly match content.id ('tab-1') with tabId ('1') ***
                        if (content.id === 'tab-' + tabId) {
                            content.classList.add('active');
                        }
                    });
                });
            });

            // Action Items Filter
            const filter = document.getElementById('owner-filter');
            const table = document.getElementById('action-items-table');
            const rows = table.querySelectorAll('tbody tr');

            filter.addEventListener('change', () => {
                const selectedOwner = filter.value;
                rows.forEach(row => {
                    if (selectedOwner === 'All' || row.dataset.owner === selectedOwner) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });

            // Chart.js
            const ctx = document.getElementById('metricsChart').getContext('2d');
            const metricsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Total Spend (Baht)', 'Total Purchases', 'Avg ROAS', 'Total Clicks', 'Avg CTR (%)'],
                    datasets: [{
                        label: 'Ad Performance Metrics',
                        data: [65629.08, 303, 2.04, 17018, 4.45],
                        backgroundColor: [
                            'rgba(139, 92, 246, 0.6)',
                            'rgba(34, 211, 238, 0.6)',
                            'rgba(236, 72, 153, 0.6)',
                             'rgba(52, 211, 153, 0.6)',
                             'rgba(251, 146, 60, 0.6)'
                        ],
                        borderColor: [
                            'rgba(139, 92, 246, 1)',
                            'rgba(34, 211, 238, 1)',
                            'rgba(236, 72, 153, 1)',
                            'rgba(52, 211, 153, 1)',
                            'rgba(251, 146, 60, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                             ticks: { color: '#94a3b8' },
                             grid: { color: '#334155' }
                        },
                        x: {
                             ticks: { color: '#94a3b8' },
                             grid: { color: '#334155' }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: {
                                color: '#cbd5e1'
                            }
                        }
                    }
                }
            });

        });
    </script>
</body>
</html>
